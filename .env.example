AI_PROVIDER_URL=https://api.example.com/v1
AI_MODEL_NAME=your-model-name
AI_API_KEY=

# Optional provider used only after the primary provider exhausts its retries.
AI_FALLBACK_PROVIDER_URL=
AI_FALLBACK_MODEL_NAME=
AI_FALLBACK_API_KEY=

# Local-only identity. Keep false to test Google sign-in.
# Never enable this on a public deployment.
LOCAL_DEV_AUTH=false
LOCAL_DEV_USER_EMAIL=owner@lumo.local
LOCAL_DEV_USER_NAME=Chủ máy

# Google sign-in for each Lumo account.
# Create a Web OAuth client in Google Cloud Console and add:
# http://localhost:3000/api/auth/google/callback
# https://your-production-domain/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# At least 32 random characters. Used only on the server to encrypt each
# account's Google refresh token before it is stored.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Shared SMTP account for automatic emails.
# Use port 587 with STARTTLS, or port 465 with SMTP_SECURE=true.
# Cloudflare Workers cannot send SMTP through port 25.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=
SMTP_AUTH_METHOD=login
SMTP_FROM_EMAIL=your-verified-sender@example.com
SMTP_FROM_NAME=Lumo
SMTP_HELO_NAME=lumo.example.com

# Optional Calendar used by the order workflow after an order is received.
# The account-specific Google connection is created from the dashboard.
GOOGLE_CALENDAR_ID=primary
